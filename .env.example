# Copy this file to `.env` and fill in the model you pulled with Ollama.
#
#   ollama pull qwen2.5:14b     # download a model
#   ollama ls                   # list the tags you already have
#
# Required: the exact tag shown by `ollama ls`. RAGM4 refuses to start without it.
OLLAMA_MODEL=

# Optional: Ollama daemon endpoint (default: http://localhost:11434)
# OLLAMA_BASE_URL=http://localhost:11434

# Optional: how long Ollama keeps the model in RAM between questions (default: 30m)
# OLLAMA_KEEP_ALIVE=30m
